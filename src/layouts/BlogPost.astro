---
import BaseLayout from './BaseLayout.astro';
import AmbientGlow from '../components/AmbientGlow.astro';
import TagList from '../components/TagList.astro';
import ContactForm from '../components/ContactForm.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SectionNav from '../components/SectionNav.astro';
import { Image } from 'astro:assets';
import { authorAvatarImage as authorImage } from '../utils/authorImages';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { resolveBlogSections } from '../utils/sectionNav';
import { themeConfig } from '../theme.config';

type AdjacentPost = {
  id: string;
  title: string;
  description: string;
} | null;

type Props = CollectionEntry<'blog'>['data'] & {
  author?: string;
  readingTime?: string;
  id?: string;
  nextPost?: AdjacentPost;
  prevPost?: AdjacentPost;
  headings?: MarkdownHeading[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  tags,
  author = themeConfig.author.name,
  readingTime,
  id,
  nextPost,
  prevPost,
  headings = [],
  showSections,
  sectionNav,
  sectionDepth,
  sections: manualSections,
} = Astro.props;

const blogSections = resolveBlogSections(
  { showSections, sectionNav, sectionDepth, sections: manualSections },
  headings
);

const ogImage = heroImage || (id ? `/og/blog/${id}.png` : '/og/blog.png');
---

<BaseLayout
  pageTitle={`${themeConfig.site.title} - ${title}`}
  description={description}
  image={ogImage}
  imageAlt={heroImageAlt || title}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  author={author}
  tags={tags}
  section={tags?.[0]}
  breadcrumbs={[{ name: "Blog", href: "/blog/" }, { name: title }]}
>
  <!-- Section navigation pills in breadcrumbs bar + Floating capsule / Back to top on scroll -->
  <SectionNav sections={blogSections} slot="breadcrumb-extra" ariaLabel="Article sections" />

  <article class="relative isolate overflow-hidden py-24 sm:py-32">
    <AmbientGlow preset="blog-post" />

    <header class="mx-auto max-w-3xl px-6 lg:px-8">
      <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-sm text-gray-500 dark:text-gray-400">
        <span class="inline-flex items-center gap-1.5">
          <span>Published</span>
          <FormattedDate date={pubDate} class="inline font-medium text-gray-700 dark:text-gray-200" />
        </span>
        {updatedDate && (
          <>
            <span class="text-gray-300 dark:text-gray-700" aria-hidden="true">&bull;</span>
            <span class="inline-flex items-center gap-1.5 font-medium text-amber-700 dark:text-amber-400">
              <svg class="size-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
              </svg>
              <span>Updated</span>
              <FormattedDate date={updatedDate} class="inline font-medium text-amber-700 dark:text-amber-400" />
            </span>
          </>
        )}
        {readingTime && (
          <>
            <span class="text-gray-300 dark:text-gray-700" aria-hidden="true">&bull;</span>
            <span class="inline-flex items-center gap-1.5 text-gray-600 dark:text-gray-300">
              <svg class="size-4 shrink-0 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              {readingTime}
            </span>
          </>
        )}
      </div>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-gray-900 dark:text-white sm:text-5xl">
        {title}
      </h1>
      <p class="mt-5 text-xl/8 text-gray-600 dark:text-gray-300">{description}</p>
    </header>

    <div class="mx-auto mt-10 max-w-3xl px-6 text-base/7 text-gray-700 dark:text-gray-300 lg:px-8">
      <div class="prose dark:prose-invert max-w-2xl text-gray-600 dark:text-gray-300">
        <slot />
        <div class="not-prose mt-8 border-t border-gray-200 dark:border-gray-800 pt-6">
          <TagList tags={tags} showLabel={true} />
        </div>
      </div>

      <!-- Adjacent Articles Navigation -->
      {(nextPost || prevPost) && (
        <nav aria-label="Adjacent articles" class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
            {nextPost ? (
              <a
                href={`/blog/${nextPost.id}/`}
                class="border-beam-card group flex flex-col justify-between rounded-2xl p-5 sm:p-6 shadow-md ring-1 ring-gray-900/5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm dark:ring-white/10 transition-all duration-200 hover:shadow-lg no-underline text-inherit"
                aria-label={`Next article: ${nextPost.title}`}
              >
                <div>
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500 mb-2">
                    <svg class="size-3.5 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m15 18-6-6 6-6"/>
                    </svg>
                    <span>Next Article</span>
                  </span>
                  <h4 class="text-base font-semibold text-gray-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors line-clamp-2">
                    {nextPost.title}
                  </h4>
                </div>
                {nextPost.description && (
                  <p class="mt-3 text-xs/5 text-gray-600 dark:text-gray-400 line-clamp-2">
                    {nextPost.description}
                  </p>
                )}
              </a>
            ) : null}

            {prevPost ? (
              <a
                href={`/blog/${prevPost.id}/`}
                class={`border-beam-card group flex flex-col justify-between rounded-2xl p-5 sm:p-6 shadow-md ring-1 ring-gray-900/5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm dark:ring-white/10 transition-all duration-200 hover:shadow-lg no-underline text-inherit ${!nextPost ? 'sm:col-start-2' : ''}`}
                aria-label={`Previous article: ${prevPost.title}`}
              >
                <div class="sm:text-right">
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-500 mb-2 sm:self-end">
                    <span>Previous Article</span>
                    <svg class="size-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m9 18 6-6-6-6"/>
                    </svg>
                  </span>
                  <h4 class="text-base font-semibold text-gray-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors line-clamp-2">
                    {prevPost.title}
                  </h4>
                </div>
                {prevPost.description && (
                  <p class="mt-3 text-xs/5 text-gray-600 dark:text-gray-400 line-clamp-2 sm:text-right">
                    {prevPost.description}
                  </p>
                )}
              </a>
            ) : null}
          </div>
        </nav>
      )}

      <!-- About the Author Box -->
      <a
        href="/about/"
        class="border-beam-card group mt-12 block rounded-2xl p-6 sm:p-8 shadow-lg ring-1 ring-gray-900/5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm dark:ring-white/10 transition-all duration-200 hover:shadow-xl cursor-pointer no-underline text-inherit"
        aria-label={`About the author: ${author}`}
      >
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
          <div class="shrink-0">
            <Image
              src={authorImage}
              alt={author}
              width={160}
              height={160}
              loading="lazy"
              class="size-16 rounded-full object-cover ring-2 ring-amber-600/30 group-hover:ring-amber-600 transition"
            />
          </div>
          <div class="space-y-1">
            <p class="text-xs font-semibold tracking-wider uppercase text-amber-600 dark:text-amber-500">About the author</p>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition flex items-center gap-1.5">
              <span>{author}</span>
              <span class="text-amber-600 dark:text-amber-500 text-sm font-normal group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
            </h3>
            <p class="text-sm/6 text-gray-600 dark:text-gray-300">
              {themeConfig.author.bio}
            </p>
          </div>
        </div>
      </a>

      <!-- Feedback / Discussion -->
      <div class="mt-12">
        <ContactForm 
          title="Thoughts or questions on this article?"
          subtitle="Found a bug, tested a similar setup, or want to discuss the details? Drop a message below."
          subject={`Feedback on: ${title}`}
          compact={true}
        />
      </div>
    </div>
  </article>

  <script>
    import '../scripts/youtube-embed';
  </script>

  <script>
    function setupCodeCopyButtons() {
      const preBlocks = document.querySelectorAll<HTMLElement>('.prose pre');
      if (preBlocks.length === 0) return;

      const copySvg = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
      const checkSvg = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4.5 12.75 6 6 9-13.5"/></svg>';

      preBlocks.forEach((pre) => {
        if (pre.parentElement?.classList.contains('code-block-wrapper')) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'code-block-wrapper relative group my-6';

        if (pre.parentNode) {
          pre.parentNode.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);
        }

        const toolbar = document.createElement('div');
        toolbar.className = 'code-block-toolbar';

        const lang = pre.getAttribute('data-language');
        if (lang && lang !== 'plaintext') {
          const badge = document.createElement('span');
          badge.className = 'code-lang-badge';
          badge.textContent = lang;
          toolbar.appendChild(badge);
        }

        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'copy-code-btn';
        copyBtn.setAttribute('aria-label', 'Copy code to clipboard');
        copyBtn.setAttribute('title', 'Copy code to clipboard');
        copyBtn.innerHTML = copySvg;

        let copiedTimeout: ReturnType<typeof setTimeout> | null = null;
        const setCopied = () => {
          if (copiedTimeout) clearTimeout(copiedTimeout);
          copyBtn.innerHTML = checkSvg;
          copyBtn.classList.add('is-copied');
          copyBtn.classList.remove('is-error');
          copyBtn.setAttribute('title', 'Copied to clipboard!');
          copyBtn.setAttribute('aria-label', 'Copied to clipboard!');
          copiedTimeout = setTimeout(() => {
            copyBtn.innerHTML = copySvg;
            copyBtn.classList.remove('is-copied');
            copyBtn.setAttribute('title', 'Copy code to clipboard');
            copyBtn.setAttribute('aria-label', 'Copy code to clipboard');
            copiedTimeout = null;
          }, 2000);
        };

        const fallbackCopy = (text: string) => {
          try {
            const textArea = document.createElement('textarea');
            textArea.value = text;
            textArea.style.position = 'fixed';
            textArea.style.left = '-999999px';
            textArea.style.top = '-999999px';
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            const success = document.execCommand('copy');
            document.body.removeChild(textArea);
            if (success) {
              setCopied();
            } else {
              throw new Error('execCommand failed');
            }
          } catch {
            copyBtn.setAttribute('title', 'Failed to copy');
            copyBtn.classList.add('is-error');
            setTimeout(() => {
              copyBtn.innerHTML = copySvg;
              copyBtn.classList.remove('is-error');
              copyBtn.setAttribute('title', 'Copy code to clipboard');
            }, 2000);
          }
        };

        copyBtn.addEventListener('click', () => {
          const code = pre.querySelector('code');
          const codeText = (code || pre).innerText;

          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(codeText).then(setCopied).catch(() => fallbackCopy(codeText));
          } else {
            fallbackCopy(codeText);
          }
        });

        toolbar.appendChild(copyBtn);
        wrapper.appendChild(toolbar);
      });
    }

    setupCodeCopyButtons();
    document.addEventListener('astro:page-load', setupCodeCopyButtons);
  </script>
</BaseLayout>
