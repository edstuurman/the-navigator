---
import PhotographyView from '../../../components/pages/PhotographyView.astro';
import { GALLERY_PAGE_SIZE } from '../../../utils/pagination';
import { photoCount } from '../../../utils/photoImages';

export async function getStaticPaths() {
  const totalPages = Math.ceil(photoCount / GALLERY_PAGE_SIZE);

  const paths = [];
  for (let page = 2; page <= totalPages; page++) {
    paths.push({
      params: { page: String(page) },
      props: { currentPage: page },
    });
  }
  return paths;
}

interface Props {
  currentPage: number;
}

const { currentPage } = Astro.props;
---

<PhotographyView currentPage={currentPage} />

