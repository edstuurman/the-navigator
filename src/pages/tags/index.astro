---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AmbientGlow from '../../components/AmbientGlow.astro';
import SectionNav from '../../components/SectionNav.astro';
import { getEntry } from 'astro:content';
import { getTagTaxonomy } from '../../utils/tagTaxonomy';
import { tagHref, isHardLinkedTag } from '../../utils/tagHref';

const { sortedTags, photoTags } = await getTagTaxonomy();
const tagsPageEntry = await getEntry('pages', 'tags');
const tagsPageData = tagsPageEntry!.data;

const pageTitle = tagsPageData.pageTitle;
const description = tagsPageData.description;
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  image="/og/tags.png"
  breadcrumbs={[{ name: "Tags" }]}
>
  <SectionNav slot="breadcrumb-extra" />

  <section class="relative isolate overflow-hidden py-24 sm:py-32">
    <AmbientGlow preset="tags-index" />

    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-5xl mb-12 sm:mb-16">
        <p class="text-base/7 font-semibold text-amber-600 dark:text-amber-500">{tagsPageData.eyebrow ?? 'Topics & Taxonomy'}</p>
        <h1 class="mt-2 text-4xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-5xl">{tagsPageData.heading ?? 'Tags'}</h1>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">
          {tagsPageData.subtitle}
        </p>
      </div>

      <!-- Engineering & Career Topics Section -->
      <div class="mx-auto max-w-5xl">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-gray-200/70 dark:border-gray-800 text-xs text-gray-500 dark:text-gray-400">
          <div class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-amber-600"></span>
            <span class="font-semibold text-sm text-gray-900 dark:text-white">Engineering & Career Topics</span>
            <span class="font-mono text-xs text-gray-500 dark:text-gray-400">({sortedTags.length})</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-300 ring-1 ring-inset ring-amber-600/30 font-semibold">
              <svg class="size-3.5 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0" />
              </svg>
              <span>Career experience</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-gray-100 dark:bg-gray-700/50 text-gray-600 dark:text-gray-400 ring-1 ring-inset ring-gray-200 dark:ring-gray-700 font-medium">
              <span>Articles & logs</span>
            </span>
          </div>
        </div>

        <div class="flex flex-wrap gap-2.5">
          {
            sortedTags.map((tag) => (
              <a 
                href={tagHref(tag.slug)} 
                class={`group inline-flex items-center gap-2 rounded-md px-3 py-1.5 text-xs sm:text-sm transition-all duration-150 ${
                  (tag.hasExperience || isHardLinkedTag(tag.slug))
                    ? 'bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-300 font-semibold ring-1 ring-inset ring-amber-600/30 hover:bg-amber-100 dark:hover:bg-amber-900/60'
                    : 'bg-gray-100 dark:bg-gray-700/50 text-gray-600 dark:text-gray-400 font-medium ring-1 ring-inset ring-gray-200 dark:ring-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600'
                }`}
                title={
                  (tag.hasExperience || isHardLinkedTag(tag.slug))
                    ? `#${tag.name}: ${tag.expCount} ${tag.expCount === 1 ? 'career role' : 'career roles'}${tag.blogCount > 0 ? ` • ${tag.blogCount} ${tag.blogCount === 1 ? 'article' : 'articles'}` : ''}${tag.logCount > 0 ? ` • ${tag.logCount} ${tag.logCount === 1 ? 'log' : 'logs'}` : ''}${tag.photoCount > 0 ? ` • ${tag.photoCount} ${tag.photoCount === 1 ? 'photo' : 'photo rolls'}` : ''}`
                    : (tag.blogCount > 0 
                        ? `#${tag.name}: ${tag.blogCount} ${tag.blogCount === 1 ? 'article' : 'articles'}${tag.logCount > 0 ? ` • ${tag.logCount} ${tag.logCount === 1 ? 'log' : 'logs'}` : ''}${tag.photoCount > 0 ? ` • ${tag.photoCount} ${tag.photoCount === 1 ? 'photo' : 'photo rolls'}` : ''}`
                        : (tag.logCount > 0 
                            ? `#${tag.name}: ${tag.logCount} ${tag.logCount === 1 ? 'log update' : 'log updates'}${tag.photoCount > 0 ? ` • ${tag.photoCount} ${tag.photoCount === 1 ? 'photo' : 'photo rolls'}` : ''}`
                            : `#${tag.name}: ${tag.photoCount} ${tag.photoCount === 1 ? 'photo' : 'photo rolls'}`
                          )
                      )
                }
              >
                {(tag.hasExperience || isHardLinkedTag(tag.slug)) && (
                  <svg 
                    class="size-3.5 shrink-0 text-amber-600 dark:text-amber-400 group-hover:text-amber-700 dark:group-hover:text-amber-300 transition-colors" 
                    fill="none" 
                    viewBox="0 0 24 24" 
                    stroke-width="2" 
                    stroke="currentColor" 
                    aria-label="Has career experience"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                  </svg>
                )}
                <span>#{tag.name}</span>
                <span class={`inline-flex items-center justify-center rounded px-1.5 py-0.5 text-xs font-mono font-medium transition-colors ${
                  (tag.hasExperience || isHardLinkedTag(tag.slug))
                    ? 'bg-amber-100 dark:bg-amber-900/70 text-amber-800 dark:text-amber-200 ring-1 ring-inset ring-amber-600/20'
                    : 'bg-gray-200/80 dark:bg-gray-600/60 text-gray-700 dark:text-gray-300 ring-1 ring-inset ring-gray-300 dark:ring-gray-600'
                }`}>
                  {tag.count}
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Dedicated Photography Section -->
      <div class="mx-auto max-w-5xl mt-16 pt-12 border-t border-gray-200/80 dark:border-gray-800">
        <div class="flex items-center justify-between gap-4 mb-6 pb-4 border-b border-gray-200/70 dark:border-gray-800">
          <div class="flex items-center gap-3">
            <div class="flex size-9 items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 ring-1 ring-inset ring-gray-200 dark:ring-gray-700">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
                <circle cx="12" cy="13" r="3"/>
              </svg>
            </div>
            <div>
              <h2 class="text-xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-2xl">
                Photography Topics
              </h2>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                Tags from the photo rolls & gallery across Japan, the Aegean, and Europe.
              </p>
            </div>
          </div>
          <span class="text-xs font-mono text-gray-500 dark:text-gray-400">
            {photoTags.length} photography topics
          </span>
        </div>

        <div class="flex flex-wrap gap-2.5">
          {
            photoTags.map((tag) => (
              <a 
                href={tagHref(tag.slug)} 
                class="group inline-flex items-center gap-2 rounded-md bg-gray-100 dark:bg-gray-800/80 px-3 py-1.5 text-xs sm:text-sm text-gray-700 dark:text-gray-300 font-medium ring-1 ring-inset ring-gray-200 dark:ring-gray-700 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-150"
                title={`#${tag.name}: ${tag.count} ${tag.count === 1 ? 'photo' : 'photo rolls'}`}
              >
                <svg class="size-3 text-gray-400 dark:text-gray-500 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M1 5.25A2.25 2.25 0 0 1 3.25 3h2.382a2.25 2.25 0 0 0 1.95-1.125l.436-.654A2.25 2.25 0 0 1 10.068 0h3.864a2.25 2.25 0 0 1 2.05 1.221l.436.654A2.25 2.25 0 0 0 18.368 3h2.382A2.25 2.25 0 0 1 23 5.25v12.5A2.25 2.25 0 0 1 20.75 20H3.25A2.25 2.25 0 0 1 1 17.75V5.25ZM12 15a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0-2a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"/>
                </svg>
                <span>#{tag.name}</span>
                <span class="inline-flex items-center justify-center rounded px-1.5 py-0.5 text-xs font-mono font-medium bg-gray-200/80 dark:bg-gray-700 text-gray-700 dark:text-gray-300 ring-1 ring-inset ring-gray-300 dark:ring-gray-600">
                  {tag.count}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
