---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getReadingTime, getReadingTimeMinutes, getWordCount } from '../../utils/readingTime';
import { hasVideoEmbed } from '../../utils/postVideo';
import { computeBlogCacheKey, type AdjacentPost } from '../../utils/blogCache';
import {
	getRelatedPosts,
	getPostSeriesContext,
	type RelatedPostItem,
	type PostSeriesContext,
} from '../../utils/relatedPosts';
import { isFeatureEnabled } from '../../utils/features';

export async function getStaticPaths() {
	if (!isFeatureEnabled('blog')) {
		return [];
	}
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);
	return posts.map((post, index) => {
		// In descending chronological order:
		// index - 1 is newer (next)
		// index + 1 is older (previous)
		const nextPost: AdjacentPost = index > 0
			? {
					id: posts[index - 1].id,
					title: posts[index - 1].data.title,
					description: posts[index - 1].data.description,
				}
			: null;
		const prevPost: AdjacentPost = index < posts.length - 1
			? {
					id: posts[index + 1].id,
					title: posts[index + 1].data.title,
					description: posts[index + 1].data.description,
				}
			: null;

		const seriesContext = getPostSeriesContext(post, posts);
		const excludeIds = new Set(seriesContext?.items.map((item) => item.id) ?? []);
		const relatedPosts = getRelatedPosts(post, posts, { limit: 3, excludeIds });

		return {
			params: { slug: post.id },
			props: {
				post,
				nextPost,
				prevPost,
				relatedPosts,
				seriesContext,
			},
			cacheKey: computeBlogCacheKey(post, nextPost, prevPost, relatedPosts, seriesContext),
		};
	});
}

interface Props {
	post: CollectionEntry<'blog'>;
	nextPost: AdjacentPost;
	prevPost: AdjacentPost;
	relatedPosts: RelatedPostItem[];
	seriesContext: PostSeriesContext | null;
}

const { post, nextPost, prevPost, relatedPosts, seriesContext } = Astro.props;
if (!isFeatureEnabled('blog') || !post) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}
const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body);
const readingTimeMinutes = getReadingTimeMinutes(post.body);
const wordCount = getWordCount(post.body);
const hasMermaid = /```mermaid\b/.test(post.body ?? '');
const hasYouTube = hasVideoEmbed(post.body);
---

<BlogPost
	{...post.data}
	id={post.id}
	readingTime={readingTime}
	readingTimeMinutes={readingTimeMinutes}
	wordCount={wordCount}
	nextPost={nextPost}
	prevPost={prevPost}
	relatedPosts={relatedPosts}
	seriesContext={seriesContext}
	headings={headings}
	hasMermaid={hasMermaid}
	hasYouTube={hasYouTube}
>
	<Content />
</BlogPost>
