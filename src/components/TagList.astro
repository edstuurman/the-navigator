---
import { experienceTagSlugs } from '../data/experiences';
import { slugify } from '../utils/slugify';
import { tagHref, isHardLinkedTag } from '../utils/tagHref';

interface Props {
	tags: string[];
	showLabel?: boolean;
	limit?: number;
	singleLine?: boolean;
}

const { tags = [], showLabel = false, limit, singleLine = false } = Astro.props;
const displayTags = limit ? tags.slice(0, limit) : tags;
---

<div class:list={[
	"tag-list not-prose items-center min-w-0",
	singleLine ? "flex flex-nowrap gap-1.5 overflow-hidden" : "flex flex-wrap gap-1.5"
]}>
	{showLabel && <span class="tag-label text-xs font-semibold text-gray-700 dark:text-gray-300 mr-1 shrink-0">Tags:</span>}
	{displayTags.map((tag) => {
		const tagSlug = slugify(tag);
		const hasExperience = experienceTagSlugs.has(tagSlug) || isHardLinkedTag(tagSlug);
		const cleanTag = tag.replace(/^#/, '');
		return (
			<a
				href={tagHref(tagSlug)}
				class:list={[
					hasExperience
						? "inline-flex items-center rounded-md bg-amber-50 dark:bg-gray-700/60 px-2.5 py-1 text-xs font-semibold text-amber-700 dark:text-amber-500 ring-1 ring-inset ring-amber-600/30 dark:ring-amber-500/30 hover:bg-amber-100 dark:hover:bg-gray-700 dark:hover:text-amber-400 transition-colors no-underline"
						: "inline-flex items-center rounded-md bg-gray-100 dark:bg-gray-700/50 px-2.5 py-1 text-xs font-medium text-gray-600 dark:text-gray-300 ring-1 ring-inset ring-gray-200 dark:ring-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors no-underline",
					singleLine && "min-w-0 shrink max-w-full"
				]}
				title={hasExperience 
					? `View articles, logs, and career experience tagged #${cleanTag}` 
					: `View articles and logs tagged #${cleanTag}`
				}
			>
				{singleLine ? (
					<span class="truncate block min-w-0">#{cleanTag}</span>
				) : (
					`#${cleanTag}`
				)}
			</a>
		);
	})}
</div>
