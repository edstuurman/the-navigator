---
/**
 * Loads the technical acronym tooltip enhancer (`src/scripts/tech-tooltips.ts`)
 * and tooltip bubble styles from `rehype-tech-tooltips`.
 * Include on any page that renders `<abbr>` tooltips (Markdown via
 * `rehype-tech-tooltips` or `Tooltip.astro`). Astro de-duplicates it per page.
 * Keep this the only importer so the module bundles as a self-contained script.
 */
import 'rehype-tech-tooltips/styles.css';
---

<script>
  import '../../scripts/tech-tooltips';
</script>

<style is:global>
  /* Neutralize Tailwind v4 `-translate-x-1/2` (`translate` property) on `Tooltip.astro` arrows
     so `rehype-tech-tooltips/styles.css` (`transform: translateX(-50%)`) does not double-shift. */
  .tech-tooltip-arrow {
    translate: 0 0;
  }
</style>
