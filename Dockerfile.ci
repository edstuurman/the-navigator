FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# 1. Install git (for sitemap lastmod) and headless Chromium shell + minimal system deps for rehype-mermaid
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
    && npx --yes playwright@1.64.1 install --with-deps --only-shell chromium \
    && apt-get clean \
    && rm -rf /ms-playwright/ffmpeg-* /var/lib/apt/lists/* /root/.npm /tmp/*

# 2. Pre-bake production/build node_modules so CI jobs link in <10ms without running npm ci
WORKDIR /opt/ci-deps
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund \
    && rm -rf /root/.npm /tmp/*

WORKDIR /

